# Archivo de ejemplo de variables de entorno
# Copiar este archivo a .env y completar con tus propias claves

# Mosqlimate API Key (X-UID-Key)
# Obtener desde: https://api.mosqlimate.org/<tu_usuario>/
# Después de autenticarte con GitHub
MOSQLIMATE_API_KEY=tu_uid_key_aqui

# --- AWS (Learner Lab) ---
# Credenciales temporales — renovar cada ~4 horas desde:
# https://labs.vocareum.com → AWS Details → AWS CLI (Show)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# --- Docker / Deployment ---
MODEL_ARTIFACT_PATH=/app/mlflow-artifacts/models/<model-version>/artifacts
API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
