# EditorConfig: https://editorconfig.org
# Formato básico compartido por todos los editores (VS Code, PyCharm, Vim...)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
end_of_line = lf

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
