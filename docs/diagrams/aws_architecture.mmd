  layout: dagre
  look: neo
---
flowchart TB
 subgraph ECS["**ECS Fargate**"]
    direction LR
        TASK_API["API · FastAPI :8000"]
        TASK_DASH["Dashboard · Streamlit :8501"]
  end
 subgraph AWS["AWS · us-east-1"]
        ECS
        ECR["**ECR**<br>dengue-api · <br>dengue-dashboard"]
        S3[("**S3** <br>dengue-mlops-data<br>parquet · model ·<br>GeoJSON")]
        CW[("CloudWatch")]
  end
    DEV(("👨‍💻 Dev")) -- git tag + push --> REPO["GitHub · DengueMLOps"]
    REPO -- on: push tags --> CI["**GitHub Actions** · deploy.yml<br>Build → Push ECR → Update ECS"]
    CI -- docker push --> ECR
    CI -- "update-service" --> ECS
    ECR -- pull --> ECS
    S3 -- entrypoint --> ECS
    ECS -- logs --> CW
    INET(("🌐 Internet")) -- HTTP · Public IP --> ECS

    TASK_API@{ shape: rect}
    style ECS fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
    style ECR fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#000
    style S3 fill:#fff9c4,stroke:#f9a825,stroke-width:2px,color:#000
