    style DEV fill:#02576c,stroke:#024d5f,color:#fff,stroke-width:2px
    style REPO fill:#f5f5f5,stroke:#333,stroke-width:2px,color:#000
    style CI fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
    style INET fill:#02576c,stroke:#024d5f,color:#fff,stroke-width:2px
    style AWS fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#000